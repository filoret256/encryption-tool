{
  "name": "encryption-tool",
  "version": "5.0.0",
  "description": "Web app for Helm- and Ansible-Vault-compatible encryption plus a git-backed code editor",
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "code-agent": "bun src/code-agent/cli.ts",
    "code-agent:go": "bun scripts/go.ts run .",
    "code-agents:build": "bun scripts/build-code-agents.ts",
    "code-agent:smoke": "bun scripts/code-agent-smoke.ts",
    "agent-client:smoke": "bun scripts/agent-client-smoke.ts",
    "code-agent:test": "bun scripts/go.ts test ./...",
    "agent-kit:test": "bun scripts/go.ts --in agent-kit-go test ./...",
    "kafka-agent": "bun scripts/go.ts --in kafka-agent-go run . --",
    "kafka-agent:go": "bun scripts/go.ts --in kafka-agent-go run . --",
    "kafka-agent:test": "bun scripts/go.ts --in kafka-agent-go test ./...",
    "kafka-agent:smoke": "bun scripts/kafka-agent-smoke.ts",
    "kafka-web:smoke": "bun scripts/kafka-web-smoke.ts",
    "slots:smoke": "bun scripts/slots-smoke.ts",
    "editor:smoke": "bun scripts/editor-smoke.ts",
    "filters:smoke": "bun scripts/filters-smoke.ts",
    "kafka-agent:pki": "bun scripts/go.ts --in kafka-agent-go run ./cmd/testpki -out testdata/pki",
    "audit": "bun scripts/audit.ts",
    "licenses": "bun scripts/go-licenses.ts",
    "protocol:check": "bun scripts/protocol-check.ts",
    "git:smoke": "bun scripts/git-smoke.ts",
    "graph:smoke": "bun scripts/graph-smoke.ts",
    "search:smoke": "bun scripts/search-smoke.ts",
    "pwa:smoke": "bun scripts/pwa-smoke.ts",
    "crypto:smoke": "bun scripts/crypto-smoke.ts",
    "isolation:smoke": "bun scripts/isolation-smoke.ts",
    "refresh:smoke": "bun scripts/refresh-smoke.ts",
    "download:smoke": "bun scripts/download-smoke.ts",
    "release:smoke": "bun scripts/release-smoke.ts",
    "build": "bun build src/web/main.ts --outdir public --target browser --minify && bun build src/web/code.ts src/web/kafka-diff.ts --outdir public --target browser --minify --splitting --chunk-naming \"editor-chunk.[ext]\" && bun build src/web/kafka.ts --outdir public --target browser --minify && bun build src/web/crypto/worker.ts --outfile public/crypto-worker.js --target browser --minify && bun build src/web/sw.ts --outdir public --target browser --minify",
    "icons": "bun scripts/make-icons.ts",
    "icons:files": "bun scripts/build-file-icons.ts",
    "compile": "bun build --compile --minify --sourcemap=none --outfile server src/server.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.30.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.5.0"
  }
}
